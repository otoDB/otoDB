{
    "manifest_version": 3,
    "name": "otoDB",
    "version": "1.3.2",
    "description": "otoDB is a community-driven website consisting of a collaborative user-managed database and wiki.",
    "background": {
    	"service_worker": "background.js",
    	"scripts": ["background.js"]
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "otoDB"
    },
    "content_scripts": [
        {
            "matches": ["https://*.nicovideo.jp/*"],
            "js": ["niconico.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": [
                "*://www.youtube.com/embed/*",
                "*://www.youtube-nocookie.com/embed/*"
            ],
            "js": ["youtube.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": ["https://otodb.net/*"],
            "js": ["otodb-prefs.js"],
            "run_at": "document_start"
        }
    ],
    "permissions": [
        "declarativeNetRequestWithHostAccess",
        "cookies",
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "https://otodb.net/*",
        "https://*.nicovideo.jp/*",
        "https://*.nicoseiga.jp/*",
        "https://www.nicochart.jp/*",
        "*://www.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "minimum_chrome_version": "111",
    "browser_specific_settings": {
        "gecko": {
            "id": "{717c1436-7545-4acd-bed8-a473bac7698b}",
            "strict_min_version": "128.0"
        }
    }
}
