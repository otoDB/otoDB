INTERNAL_API_ENDPOINT=http://127.0.0.1:8000/
INTERNAL_API_SECRET="secret"

PUBLIC_API_ENDPOINT=http://127.0.0.1:8000/
PUBLIC_OTODB_HASH="ffffff"

# Discord server invite code (optional)
PUBLIC_DISCORD_INVITE_CODE=

# Captcha (optional)
# Test value that always passes: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Sentry monitoring (optional)
OTODB_FRONTEND_SENTRY_DSN=
OTODB_FRONTEND_SENTRY_TRACES_SAMPLE_RATE=0.1

# Mirror of backend OTODB_INVITE_REQUIRED
OTODB_INVITE_REQUIRED=False

# ! The below are only relevant in a development context !
# Address the vite dev server binds to; defaults to 127.0.0.1 when unset.
# OTODB_DEV_BIND=127.0.0.1
# Port the vite dev server listens on; when set, the port is also enforced (no fallback)
# OTODB_DEV_FRONTEND_PORT=5173
# Comma-separated extra Host headers vite accepts, e.g. ".dev.example.com"; may be empty
# OTODB_DEV_ALLOWED_HOSTS=
# Backend port for browser-side API calls; the hostname is taken from the current page.
# PUBLIC_API_PORT=8000
