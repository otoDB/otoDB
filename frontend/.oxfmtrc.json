{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortTailwindcss": {},
	"quoteProps": "consistent",
	"sortPackageJson": false,
	"ignorePatterns": [
		"package-lock.json",
		"pnpm-lock.yaml",
		"yarn.lock",
		"src/lib/schema.ts",
		"messages/",
		"static/mockServiceWorker.js"
	],
	"svelte": true
}
